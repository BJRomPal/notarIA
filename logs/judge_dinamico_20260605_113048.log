------------------------------
MATCH (ley_22315:Norma {id: "Ley_22315"})-[:CONTIENE]->(art_22315:Articulo)
MATCH (art_22315)-[r_igj]-(:InspeccionGeneralDeJusticia)
MATCH (art_22315)-[r_sa]-(:SociedadAnonima)
WHERE type(r_igj) IN ['REGULA', 'DEFINE', 'MENCIONA', 'ADMINISTRA', 'FISCALIZA', 'ESTABLECE_REQUISITOS_DE', 'ES_AUTORIDAD_DE']
