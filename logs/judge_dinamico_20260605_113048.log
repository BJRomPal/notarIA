11:43:03 [INFO]   [Grafo] Cypher:
------------------------------
// Parte 1 y 2: Obligatoriedad de la sindicatura en una SA y requisitos de síndicos según la LSC (Ley 19.550)
MATCH (lsc:Norma {id: "Ley_19550"})-[:CONTIENE]->(art_lsc:Articulo)
WHERE (
    EXISTS((art_lsc)-[:REGULA|DEFINE|MENCIONA|ESTABLECE_REQUISITOS_DE|FISCALIZA]-(:Sindico)) OR
    EXISTS((art_lsc)-[:REGULA|DEFINE|MENCIONA|ESTABLECE_REQUISITOS_DE|FISCALIZA]-(:Sindicatura)) OR
    EXISTS((art_lsc)-[:REGULA|DEFINE|MENCIONA|ESTABLECE_REQUISITOS_DE|FISCALIZA]-(:SociedadAnonima))
    OR // Incluir artículos que mencionen las palabras clave relevantes, incluso sin relación directa a una entidad específica
    (toLower(art_lsc.texto) CONTAINS 'sindicatura' OR toLower(art_lsc.texto) CONTAINS 'síndico' OR toLower(art_lsc.texto) CONTAINS 'fiscalización')
)
AND (toLower(art_lsc.texto) CONTAINS 'obligatoria' OR toLower(art_lsc.texto) CONTAINS 'requisitos' OR toLower(art_lsc.texto) CONTAINS 'designación' OR toLower(art_lsc.texto) CONTAINS 'sociedad anónima' OR toLower(art_lsc.texto) CONTAINS 'sa')
WITH collect(DISTINCT art_lsc) AS lsc_articles

// Parte 3: Documentación requerida por la RG IGJ 15/2024 para inscribir la designación de síndicos ante la IGJ
MATCH (rg_igj:Norma {id: "RG_15_2024"})-[:CONTIENE]->(art_rg:Articulo)
WHERE (
    EXISTS((art_rg)-[:REGULA|MENCIONA|ESTABLECE_REQUISITOS_DE|SE_INSCRIBE_EN]-(:Sindico)) OR
    EXISTS((art_rg)-[:REGULA|MENCIONA|ESTABLECE_REQUISITOS_DE|SE_INSCRIBE_EN]-(:Sindicatura)) OR
    EXISTS((art_rg)-[:REGULA|MENCIONA|ESTABLECE_REQUISITOS_DE|SE_INSCRIBE_EN]-(:InspeccionGeneralDeJusticia)) OR
    EXISTS((art_rg)-[:REGULA|MENCIONA|ESTABLECE_REQUISITOS_DE|SE_INSCRIBE_EN]-(:RegistroPublico))
    OR // Incluir artículos que mencionen las palabras clave relevantes, incluso sin relación directa a una entidad específica
    (toLower(art_rg.texto) CONTAINS 'sindicatura' OR toLower(art_rg.texto) CONTAINS 'síndico')
)
AND (toLower(art_rg.texto) CONTAINS 'documentación' OR toLower(art_rg.texto) CONTAINS 'inscripción' OR toLower(art_rg.texto) CONTAINS 'designación' OR toLower(art_rg.texto) CONTAINS 'trámite')
AND (toLower(art_rg.texto) CONTAINS 'igj' OR toLower(art_rg.texto) CONTAINS 'registro público')
WITH lsc_articles, collect(DISTINCT art_rg) AS rg_articles

// Combinar todos los artículos relevantes y retornar
WITH lsc_articles + rg_articles AS all_relevant_articles
UNWIND all_relevant_articles AS art
RETURN DISTINCT art.id AS id, art.numero AS numero, art.texto AS texto
LIMIT 5
