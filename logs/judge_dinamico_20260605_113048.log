------------------------------
// ¿Qué requisitos establece la LSC para la transformación de una SRL en SA?
MATCH (lsc:Norma {id: "Ley_19550"})-[:CONTIENE]->(art_lsc:Articulo)
WHERE (toLower(art_lsc.texto) CONTAINS 'transformación' OR toLower(art_lsc.texto) CONTAINS 'transformacion')
  AND (toLower(art_lsc.texto) CONTAINS 'sociedad de responsabilidad limitada' OR toLower(art_lsc.texto) CONTAINS 'srl')
  AND (toLower(art_lsc.texto) CONTAINS 'sociedad anónima' OR toLower(art_lsc.texto) CONTAINS 'sa')
  AND (toLower(art_lsc.texto) CONTAINS 'requisitos' OR toLower(art_lsc.texto) CONTAINS 'condiciones' OR toLower(art_lsc.texto) CONTAINS 'procedimiento')
RETURN art_lsc.id AS id, art_lsc.numero AS numero, art_lsc.texto AS texto

UNION

// ¿Y qué documentación exige la RG IGJ 15/2024 para inscribir esa transformación ante la IGJ?
MATCH (rg_norma:Norma {id: "RG_15_2024"})-[:CONTIENE]->(art_rg:Articulo)
WHERE (rg_norma)-[:REGLAMENTA_TRAMITES]->(:Norma {id: "Ley_19550"})
  AND (
      (art_rg)-[:ADMINISTRA|FISCALIZA|MENCIONA]->(:InspeccionGeneralDeJusticia)
      OR (toLower(art_rg.texto) CONTAINS 'igj' OR toLower(art_rg.texto) CONTAINS 'inspección general de justicia')
  )
  AND (toLower(art_rg.texto) CONTAINS 'documentación' OR toLower(art_rg.texto) CONTAINS 'inscripción' OR toLower(art_rg.texto) CONTAINS 'trámite' OR toLower(art_rg.texto) CONTAINS 'presentación')
  AND (toLower(art_rg.texto) CONTAINS 'transformación' OR toLower(art_rg.texto) CONTAINS 'transformacion')
  AND (toLower(art_rg.texto) CONTAINS 'sociedad de responsabilidad limitada' OR toLower(art_rg.texto) CONTAINS 'srl')
  AND (toLower(art_rg.texto) CONTAINS 'sociedad anónima' OR toLower(art_rg.texto) CONTAINS 'sa')
RETURN art_rg.id AS id, art_rg.numero AS numero, art_rg.texto AS texto
LIMIT 5
------------------------------
