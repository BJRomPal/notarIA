// Parte 1: Requisitos e inhabilidades para directores de SA según LSC (Ley 19.550)
MATCH (lsc:Norma {id: "Ley_19550"})-[:CONTIENE]->(art_lsc:Articulo)
WHERE (
    EXISTS((art_lsc)-[:ESTABLECE_REQUISITOS_DE|PROHIBE|REGULA|MENCIONA]->(:Director))
    OR EXISTS((art_lsc)-[:ESTABLECE_REQUISITOS_DE|PROHIBE|REGULA|MENCIONA]->(:SociedadAnonima))
    OR toLower(art_lsc.texto) CONTAINS 'director'
    OR toLower(art_lsc.texto) CONTAINS 'directorio'
    OR toLower(art_lsc.texto) CONTAINS 'administrador'
    OR toLower(art_lsc.texto) CONTAINS 'requisitos'
    OR toLower(art_lsc.texto) CONTAINS 'inhabilidades'
    OR toLower(art_lsc.texto) CONTAINS 'impedimentos'
    OR toLower(art_lsc.texto) CONTAINS 'prohibiciones'
)
RETURN DISTINCT art_lsc.id AS id, art_lsc.numero AS numero, art_lsc.texto AS texto

UNION ALL

// Parte 2: Documentación para inscribir designación de nuevas autoridades ante IGJ según RG IGJ 15/2024
MATCH (rg_igj:Norma {id: "RG_15_2024"})-[:CONTIENE]->(art_rg:Articulo)
WHERE (
    EXISTS((art_rg)-[:ESTABLECE_REQUISITOS_DE|SE_INSCRIBE_EN|REGULA|MENCIONA]->(:InspeccionGeneralDeJusticia))
    OR EXISTS((art_rg)-[:ESTABLECE_REQUISITOS_DE|SE_INSCRIBE_EN|REGULA|MENCIONA]->(:RegistroPublico))
    OR toLower(art_rg.texto) CONTAINS 'documentación'
    OR toLower(art_rg.texto) CONTAINS 'inscripción'
    OR toLower(art_rg.texto) CONTAINS 'designación'
    OR toLower(art_rg.texto) CONTAINS 'autoridades'
    OR toLower(art_rg.texto) CONTAINS 'director'
    OR toLower(art_rg.texto) CONTAINS 'administrador'
    OR toLower(art_rg.texto) CONTAINS 'igj'
    OR toLower(art_rg.texto) CONTAINS 'registro público'
)
RETURN DISTINCT art_rg.id AS id, art_rg.numero AS numero, art_rg.texto AS texto
LIMIT 5
------------------------------
