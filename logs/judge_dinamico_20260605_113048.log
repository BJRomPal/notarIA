11:31:13 [INFO]   [Grafo] Cypher:
------------------------------
// Parte 1: Requisitos del estatuto de una Sociedad Anónima según la LSC (Ley 19.550)
MATCH (lsc:Norma {id: "Ley_19550"})-[:CONTIENE]->(art_lsc:Articulo)
WHERE (toLower(art_lsc.texto) CONTAINS 'estatuto' OR toLower(art_lsc.texto) CONTAINS 'constitución')
  AND (toLower(art_lsc.texto) CONTAINS 'requisitos' OR toLower(art_lsc.texto) CONTAINS 'contenido')
  AND (EXISTS((art_lsc)-[:REGULA|DEFINE|MENCIONA|ESTABLECE_REQUISITOS_DE]->(:SociedadAnonima)) OR toLower(art_lsc.texto) CONTAINS 'sociedad anónima')
WITH collect(DISTINCT art_lsc) AS lsc_articles

// Parte 2: Documentación exigida por la RG IGJ 15/2024 para la inscripción de constitución de SA ante la IGJ
MATCH (rg:Norma {id: "RG_15_2024"})-[:CONTIENE]->(art_rg:Articulo)
WHERE (toLower(art_rg.texto) CONTAINS 'documentación' OR toLower(art_rg.texto) CONTAINS 'requisitos')
  AND (toLower(art_rg.texto) CONTAINS 'inscripción' OR toLower(art_rg.texto) CONTAINS 'constitución')
  AND (toLower(art_rg.texto) CONTAINS 'sociedad anónima' OR toLower(art_rg.texto) CONTAINS 'sa')
  AND (EXISTS((art_rg)-[:REGULA|MENCIONA|ESTABLECE_REQUISITOS_DE]->(:InspeccionGeneralDeJusticia)) OR EXISTS((art_rg)-[:REGULA|MENCIONA|ESTABLECE_REQUISITOS_DE]->(:RegistroPublico)) OR toLower(art_rg.texto) CONTAINS 'igj' OR toLower(art_rg.texto) CONTAINS 'registro público')
WITH lsc_articles, collect(DISTINCT art_rg) AS rg_articles

// Combinar y retornar los resultados
WITH lsc_articles + rg_articles AS all_articles
UNWIND all_articles AS art
WITH art WHERE art IS NOT NULL
RETURN DISTINCT art.id AS id, art.numero AS numero, art.texto AS texto
LIMIT 5
------------------------------
