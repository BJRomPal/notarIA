------------------------------
MATCH (igj:InspeccionGeneralDeJusticia)
MATCH (sa:SociedadAnonima)
MATCH (n_22315:Norma {id: "Ley_22315"})
MATCH (n_15_2024:Norma {id: "RG_15_2024"})

// Parte 1: Sanciones de la IGJ a SA por incumplimiento de inscripción
OPTIONAL MATCH (n_22315)-[:CONTIENE]->(art_sanciones_22315:Articulo)
WHERE (toLower(art_sanciones_22315.texto) CONTAINS 'sancion' OR toLower(art_sanciones_22315.texto) CONTAINS 'incumplimiento' OR toLower(art_sanciones_22315.texto) CONTAINS 'inscripcion')
AND EXISTS((art_sanciones_22315)-[:REGULA|MENCIONA|ESTABLECE_REQUISITOS_DE|FISCALIZA]-(igj))
AND EXISTS((art_sanciones_22315)-[:REGULA|MENCIONA|ESTABLECE_REQUISITOS_DE]-(sa))

OPTIONAL MATCH (n_15_2024)-[:CONTIENE]->(art_sanciones_15_2024:Articulo)
WHERE (toLower(art_sanciones_15_2024.texto) CONTAINS 'sancion' OR toLower(art_sanciones_15_2024.texto) CONTAINS 'incumplimiento' OR toLower(art_sanciones_15_2024.texto) CONTAINS 'inscripcion')
AND EXISTS((art_sanciones_15_2024)-[:REGULA|MENCIONA|ESTABLECE_REQUISITOS_DE|FISCALIZA]-(igj))
AND EXISTS((art_sanciones_15_2024)-[:REGULA|MENCIONA|ESTABLECE_REQUISITOS_DE]-(sa))

// Parte 2: Tribunal de apelación según Ley 22315
OPTIONAL MATCH (n_22315)-[:CONTIENE]->(art_appeal_22315:Articulo)
WHERE (toLower(art_appeal_22315.texto) CONTAINS 'apelacion' OR toLower(art_appeal_22315.texto) CONTAINS 'recurso' OR toLower(art_appeal_22315.texto) CONTAINS 'tribunal' OR toLower(art_appeal_22315.texto) CONTAINS 'camara nacional de apelaciones')
AND EXISTS((art_appeal_22315)-[:REGULA|MENCIONA|ES_AUTORIDAD_DE]-(igj))

