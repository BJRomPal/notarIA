11:34:19 [INFO]   [Grafo] Cypher:
------------------------------
// Parte 1: Libros obligatorios para Sociedades Anónimas según la Ley General de Sociedades (Ley 19.550)
MATCH (sa:SociedadAnonima)
MATCH (art_lsc:Articulo)-[r_sa]-(sa)
WHERE type(r_sa) IN ['REGULA', 'MENCIONA', 'ESTABLECE_REQUISITOS_DE']
MATCH (lsc:Norma {id: "Ley_19550"})-[:CONTIENE]->(art_lsc)
WHERE (toLower(art_lsc.texto) CONTAINS 'libros' AND toLower(art_lsc.texto) CONTAINS 'obligatorios')

// Parte 2: Procedimiento de rúbrica de libros ante la IGJ según la Resolución General IGJ 15/2024
MATCH (igj:InspeccionGeneralDeJusticia)
MATCH (art_rg:Articulo)-[r_igj]-(igj)
WHERE type(r_igj) IN ['REGULA', 'MENCIONA', 'ESTABLECE_REQUISITOS_DE', 'ADMINISTRA']
MATCH (rg:Norma {id: "RG_15_2024"})-[:CONTIENE]->(art_rg)
WHERE (toLower(art_rg.texto) CONTAINS 'rúbrica' OR toLower(art_rg.texto) CONTAINS 'rubrica')
  AND (toLower(art_rg.texto) CONTAINS 'libros' OR toLower(art_rg.texto) CONTAINS 'solicitud' OR toLower(art_rg.texto) CONTAINS 'procedimiento')

// Combinar y retornar los resultados
WITH collect(DISTINCT art_lsc) AS lsc_results, collect(DISTINCT art_rg) AS rg_results
UNWIND (lsc_results + rg_results) AS art
RETURN DISTINCT art.id AS id, art.numero AS numero, art.texto AS texto
LIMIT 5
------------------------------
