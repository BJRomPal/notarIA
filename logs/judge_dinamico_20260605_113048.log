------------------------------
MATCH (norma_lsc:Norma {id: "Ley_19550"})-[:CONTIENE]->(art_lsc:Articulo)
OPTIONAL MATCH (art_lsc)-[r_lsc]-(sa:SociedadAnonima)
WHERE type(r_lsc) IN ['REGULA', 'DEFINE', 'MENCIONA', 'ESTABLECE_REQUISITOS_DE']
  AND (
    toLower(art_lsc.texto) CONTAINS 'asamblea ordinaria' OR
    toLower(art_lsc.texto) CONTAINS 'quórum' OR
    toLower(art_lsc.texto) CONTAINS 'celebración' OR
    toLower(art_lsc.texto) CONTAINS 'convocatoria'
  )
WITH collect(DISTINCT art_lsc) AS lsc_relevant_articles

MATCH (norma_rg:Norma {id: "RG_15_2024"})-[:CONTIENE]->(art_rg:Articulo)
OPTIONAL MATCH (art_rg)-[r_rg]-(igj:InspeccionGeneralDeJusticia)
WHERE type(r_rg) IN ['REGULA', 'DEFINE', 'MENCIONA', 'ESTABLECE_REQUISITOS_DE', 'ADMINISTRA', 'FISCALIZA']
  AND (
    toLower(art_rg.texto) CONTAINS 'acta de asamblea' OR
    toLower(art_rg.texto) CONTAINS 'presentación' OR
    toLower(art_rg.texto) CONTAINS 'igj' OR
    toLower(art_rg.texto) CONTAINS 'obligación' OR
    toLower(art_rg.texto) CONTAINS 'plazo'
  )
WITH lsc_relevant_articles, collect(DISTINCT art_rg) AS rg_relevant_articles

WITH lsc_relevant_articles + rg_relevant_articles AS all_articles
UNWIND all_articles AS art
WITH art WHERE art IS NOT NULL
RETURN DISTINCT art.id AS id, art.numero AS numero, art.texto AS texto
