  AND (toLower(art_22315.texto) CONTAINS 'fiscalización' OR toLower(art_22315.texto) CONTAINS 'control' OR toLower(art_22315.texto) CONTAINS 'inspección')
WITH collect(DISTINCT art_22315) AS fiscalizacion_arts

MATCH (rg_15_2024:Norma {id: "RG_15_2024"})-[:CONTIENE]->(art_rg15:Articulo)
MATCH (art_rg15)-[r_igj_rg]-(:InspeccionGeneralDeJusticia)
MATCH (art_rg15)-[r_sa_rg]-(:SociedadAnonima)
WHERE type(r_igj_rg) IN ['REGLAMENTA_TRAMITES', 'ADMINISTRA', 'ESTABLECE_REQUISITOS_DE', 'SE_INSCRIBE_EN']
  AND type(r_sa_rg) IN ['REGULA', 'MENCIONA', 'ESTABLECE_REQUISITOS_DE']
  AND (toLower(art_rg15.texto) CONTAINS 'inscripción' OR toLower(art_rg15.texto) CONTAINS 'trámite' OR toLower(art_rg15.texto) CONTAINS 'registro' OR toLower(art_rg15.texto) CONTAINS 'control')
WITH fiscalizacion_arts, collect(DISTINCT art_rg15) AS tramites_arts

UNWIND (fiscalizacion_arts + tramites_arts) AS art
WITH art WHERE art IS NOT NULL
RETURN DISTINCT art.id AS id, art.numero AS numero, art.texto AS texto
