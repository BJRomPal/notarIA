OPTIONAL MATCH (art_rg)-[:ES_AUTORIDAD_DE|ADMINISTRA|FISCALIZA|SE_INSCRIBE_EN]-(igj:InspeccionGeneralDeJusticia)
WHERE igj IS NOT NULL OR toLower(art_rg.texto) CONTAINS 'igj'
WITH lsc_articles, collect(DISTINCT art_rg) AS rg_articles

WITH lsc_articles + rg_articles AS all_articles
UNWIND all_articles AS art
WITH art WHERE art IS NOT NULL
RETURN DISTINCT art.id AS id, art.numero AS numero, art.texto AS texto
