------------------------------
// Match Art. 299 of Ley 19.550, which defines which SAs are subject to permanent fiscalization by IGJ
MATCH (n_lsc:Norma {id: "Ley_19550"})-[:CONTIENE]->(art_299:Articulo {numero: "299"})
WHERE toLower(art_299.texto) CONTAINS 'sociedad anónima'
  AND (toLower(art_299.texto) CONTAINS 'fiscalización permanente' OR toLower(art_299.texto) CONTAINS 'inspección general de justicia' OR toLower(art_299.texto) CONTAINS 'igj')

// Match articles from Ley 22.315 that describe the functions of the IGJ
MATCH (n_22315:Norma {id: "Ley_22315"})-[:CONTIENE]->(art_22315:Articulo)
WHERE (toLower(art_22315.texto) CONTAINS 'inspección general de justicia' OR toLower(art_22315.texto) CONTAINS 'igj')
  AND (toLower(art_22315.texto) CONTAINS 'funciones' OR toLower(art_22315.texto) CONTAINS 'fiscaliza' OR toLower(art_22315.texto) CONTAINS 'administra' OR toLower(art_22315.texto) CONTAINS 'control')

// Match articles from RG 15/2024 that establish documentary presentation obligations
MATCH (n_rg:Norma {id: "RG_15_2024"})-[:CONTIENE]->(art_rg:Articulo)
WHERE (toLower(art_rg.texto) CONTAINS 'presentación' OR toLower(art_rg.texto) CONTAINS 'documental' OR toLower(art_rg.texto) CONTAINS 'obligaciones')
  AND (toLower(art_rg.texto) CONTAINS 'sociedad anónima' OR toLower(art_rg.texto) CONTAINS 'igj' OR toLower(art_rg.texto) CONTAINS 'trámites')

// Collect all distinct articles found from the three parts of the query
WITH COLLECT(DISTINCT art_299) AS articles_299,
     COLLECT(DISTINCT art_22315) AS articles_22315,
     COLLECT(DISTINCT art_rg) AS articles_rg

// Unwind the collected articles into a single stream
UNWIND (articles_299 + articles_22315 + articles_rg) AS art
WITH art WHERE art IS NOT NULL // Filter out any nulls if a collection was empty
RETURN DISTINCT art.id AS id, art.numero AS numero, art.texto AS texto
LIMIT 5
