MATCH (lsc:Norma {id: "Ley_19550"})-[:CONTIENE]->(art_lsc:Articulo)
OPTIONAL MATCH (art_lsc)-[r_lsc]-(sau_entity:SociedadAnonimaUnipersonal)
WHERE type(r_lsc) IN ['REGULA', 'DEFINE', 'MENCIONA', 'ESTABLECE_REQUISITOS_DE']
