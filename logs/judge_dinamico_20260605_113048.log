------------------------------
// Part 1: Articles from Ley 19.550 (LSC) defining escisión societaria and its requirements.
MATCH (lsc:Norma {id: "Ley_19550"})-[:CONTIENE]->(art_lsc:Articulo)
WHERE toLower(art_lsc.texto) CONTAINS 'escisión' OR toLower(art_lsc.texto) CONTAINS 'escision'
WITH collect(DISTINCT art_lsc) AS lsc_articles

// Part 2: Articles from RG 15/2024 regarding documentation for IGJ inscription of escisión.
MATCH (rg:Norma {id: "RG_15_2024"})-[:CONTIENE]->(art_rg:Articulo)
WHERE (toLower(art_rg.texto) CONTAINS 'escisión' OR toLower(art_rg.texto) CONTAINS 'escision')
  AND (toLower(art_rg.texto) CONTAINS 'documentación' OR toLower(art_rg.texto) CONTAINS 'inscripción')
  AND (EXISTS((art_rg)-[:SE_INSCRIBE_EN]->(:RegistroPublico)) OR EXISTS((art_rg)-[:ADMINISTRA]->(:InspeccionGeneralDeJusticia)))
WITH lsc_articles, collect(DISTINCT art_rg) AS rg_articles

// Combine all relevant articles
WITH lsc_articles + rg_articles AS all_articles
UNWIND all_articles AS art
RETURN DISTINCT art.id AS id, art.numero AS numero, art.texto AS texto
LIMIT 5
------------------------------
