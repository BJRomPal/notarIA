14:33:32 [INFO]   [Grafo] Cypher:
------------------------------
MATCH (decreto:Norma {id: "Decreto_1493_82"})-[:CONTIENE]->(art:Articulo)
WHERE toLower(art.texto) CONTAINS 'comunicar'
   OR toLower(art.texto) CONTAINS 'obligatoriamente'
   OR toLower(art.texto) CONTAINS 'plazo'
   OR toLower(art.texto) CONTAINS 'situaciones'
   OR toLower(art.texto) CONTAINS 'fiscalización'

// Path 1: Article directly relates to InspeccionGeneralDeJusticia
OPTIONAL MATCH (art)-[r_igj_direct]-(igj_direct:InspeccionGeneralDeJusticia)
WHERE type(r_igj_direct) IN ['REGULA', 'MENCIONA', 'ESTABLECE_REQUISITOS_DE', 'FISCALIZA', 'ES_AUTORIDAD_DE']

// Path 2: Article relates to an entity, and that entity is fiscalized by InspeccionGeneralDeJusticia
OPTIONAL MATCH (art)-[r_entity]-(entity)
WHERE NOT (entity:Norma) AND NOT (entity:Articulo) // Ensure 'entity' is one of the ontological entities
  AND type(r_entity) IN ['REGULA', 'MENCIONA', 'ESTABLECE_REQUISITOS_DE']
OPTIONAL MATCH (entity)-[r_fiscaliza]-(igj_indirect:InspeccionGeneralDeJusticia)
WHERE type(r_fiscaliza) = 'FISCALIZA'

// Combine results: an article is relevant if it directly relates to IGJ,
// or if it relates to an entity fiscalized by IGJ,
// or if its text explicitly mentions IGJ (as a fallback for graph incompleteness).
WITH art, igj_direct, igj_indirect
WHERE igj_direct IS NOT NULL
   OR igj_indirect IS NOT NULL
   OR toLower(art.texto) CONTAINS 'inspección general de justicia'
   OR toLower(art.texto) CONTAINS 'igj'

RETURN DISTINCT art.id AS id, art.numero AS numero, art.texto AS texto
LIMIT 5
