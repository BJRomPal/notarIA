MATCH (norma_22315:Norma {id: "Ley_22315"})-[:CONTIENE]->(art:Articulo)
WHERE (toLower(art.texto) CONTAINS 'inspección general de justicia' OR toLower(art.texto) CONTAINS 'igj')
  AND (
    toLower(art.texto) CONTAINS 'constitución' OR
    toLower(art.texto) CONTAINS 'capital' OR
    toLower(art.texto) CONTAINS 'disolución' OR
    toLower(art.texto) CONTAINS 'debentures'
  )
  AND EXISTS {
    MATCH (art)-[]-(sociedad)
    WHERE labels(sociedad) IN [
        ['SociedadAnonima'],
        ['SociedadAnonimaConParticipacionEstatalMayoritaria'],
        ['SociedadAnonimaUnipersonal'],
        ['SociedadEnComanditaPorAcciones'],
        ['SociedadPorAccionesSimplificada'],
        ['SociedadPorAcciones']
    ]
  }
RETURN DISTINCT art.id AS id, art.numero AS numero, art.texto AS texto
