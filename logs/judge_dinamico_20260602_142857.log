------------------------------
MATCH (art:Articulo)
WHERE (
    // El artículo debe estar relacionado con la IGJ, Directores y Sociedades Anónimas
    EXISTS { (art)-[:FISCALIZA|ADMINISTRA|ES_AUTORIDAD_DE|REGULA|MENCIONA]-(:InspeccionGeneralDeJusticia) }
    AND EXISTS { (art)-[:REGULA|MENCIONA|ESTABLECE_REQUISITOS_DE]-(:Director) }
    AND EXISTS { (art)-[:REGULA|MENCIONA|DEFINE]-(:SociedadAnonima) }
)
AND (
    // El texto del artículo debe contener palabras clave relacionadas con sanciones u obligaciones
    toLower(art.texto) CONTAINS 'sancion' OR
    toLower(art.texto) CONTAINS 'incumplimiento' OR
    toLower(art.texto) CONTAINS 'obligacion'
)
AND (
    // El texto del artículo debe contener palabras clave relacionadas con apelación o tribunal
    toLower(art.texto) CONTAINS 'apelacion' OR
    toLower(art.texto) CONTAINS 'recurso' OR
    toLower(art.texto) CONTAINS 'tribunal'
)
AND (
    // El texto del artículo debe contener palabras clave relacionadas con plazos
    toLower(art.texto) CONTAINS 'plazo' OR
    toLower(art.texto) CONTAINS 'termino'
)
RETURN DISTINCT art.id AS id, art.numero AS numero, art.texto AS texto
LIMIT 5
