    toLower(art_srl.texto) CONTAINS 'gerente' OR
    toLower(art_srl.texto) CONTAINS 'decisiones' OR
    toLower(art_srl.texto) CONTAINS 'reunión de socios' OR
    toLower(art_srl.texto) CONTAINS 'asamblea' OR
    toLower(art_srl.texto) CONTAINS 'votación' OR
    toLower(art_srl.texto) CONTAINS 'mayorías'
)

MATCH (norma_srl:Norma)-[:CONTIENE]->(art_srl)

OPTIONAL MATCH (norma_srl)-[:APLICA_SUPLETORIAMENTE]->(norma_sup:Norma)-[:CONTIENE]->(art_sup:Articulo)
WHERE (
    toLower(art_sup.texto) CONTAINS 'administración' OR
    toLower(art_sup.texto) CONTAINS 'gerencia' OR
    toLower(art_sup.texto) CONTAINS 'gerente' OR
    toLower(art_sup.texto) CONTAINS 'decisiones' OR
    toLower(art_sup.texto) CONTAINS 'reunión de socios' OR
    toLower(art_sup.texto) CONTAINS 'asamblea' OR
    toLower(art_sup.texto) CONTAINS 'votación' OR
    toLower(art_sup.texto) CONTAINS 'mayorías'
)

WITH collect(DISTINCT art_srl) + collect(DISTINCT art_sup) AS todos
UNWIND todos AS art
WITH art WHERE art IS NOT NULL
RETURN DISTINCT art.id AS id, art.numero AS numero, art.texto AS texto
