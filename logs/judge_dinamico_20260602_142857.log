14:34:50 [INFO]   [Grafo] Cypher:
------------------------------
OPTIONAL MATCH (art_sas_const:Articulo)-[r_sas_const]-(:SociedadPorAccionesSimplificada)
WHERE type(r_sas_const) IN ['DEFINE', 'REGULA', 'AUTORIZA', 'ESTABLECE_REQUISITOS_DE']
  AND (toLower(art_sas_const.texto) CONTAINS 'unipersonal'
       OR toLower(art_sas_const.texto) CONTAINS 'socio único'
       OR toLower(art_sas_const.texto) CONTAINS 'persona humana'
       OR toLower(art_sas_const.texto) CONTAINS 'constitución')

OPTIONAL MATCH (art_igj_role:Articulo)-[r_igj_role]-(:InspeccionGeneralDeJusticia)
WHERE type(r_igj_role) IN ['ADMINISTRA', 'FISCALIZA', 'ESTABLECE_REQUISITOS_DE', 'REGULA']
  AND (toLower(art_igj_role.texto) CONTAINS 'inscripción'
       OR toLower(art_igj_role.texto) CONTAINS 'trámite'
       OR toLower(art_igj_role.texto) CONTAINS 'control'
       OR toLower(art_igj_role.texto) CONTAINS 'requisitos'
       OR toLower(art_igj_role.texto) CONTAINS 'fiscaliza')
  AND (toLower(art_igj_role.texto) CONTAINS 'sas'
       OR toLower(art_igj_role.texto) CONTAINS 'sociedad por acciones simplificada'
       OR toLower(art_igj_role.texto) CONTAINS 'sociedades comerciales')

OPTIONAL MATCH (decreto:Norma {id: "Decreto_1493_82"})-[:CONTIENE]->(art_decreto_plazos:Articulo)
WHERE toLower(art_decreto_plazos.texto) CONTAINS 'plazo'
   OR toLower(art_decreto_plazos.texto) CONTAINS 'término'
   OR toLower(art_decreto_plazos.texto) CONTAINS 'días'
   OR toLower(art_decreto_plazos.texto) CONTAINS 'vencimiento'

WITH collect(DISTINCT art_sas_const) AS sas_const_articles,
     collect(DISTINCT art_igj_role) AS igj_role_articles,
     collect(DISTINCT art_decreto_plazos) AS decreto_plazos_articles

WITH sas_const_articles + igj_role_articles + decreto_plazos_articles AS all_articles
UNWIND all_articles AS art
WITH art WHERE art IS NOT NULL

RETURN DISTINCT art.id AS id, art.numero AS numero, art.texto AS texto
LIMIT 5
------------------------------
